{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dds/dds_draft_v1.schema.json",
  "title": "DDS Draft Evidence Contract v1",
  "description": "Versioned evidence contract for a draft due diligence statement payload. This contract captures provenance, field-level source mapping, validation status, and evidence hashes only. It is not an automated EUDR compliance determination.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "draft_id",
    "internal_reference_number",
    "mapper",
    "portal_intake",
    "evidence_bundle",
    "field_values",
    "pre_submission_gates",
    "validation_result",
    "evidence_hashes",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dds_draft_v1",
      "description": "Versioned DDS draft contract identifier."
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp for when this draft contract was generated."
    },
    "draft_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable internal identifier for this draft artifact."
    },
    "internal_reference_number": {
      "type": "string",
      "minLength": 1,
      "description": "Operator- or portal-facing reference used to correlate intake, evidence, review, and submission records."
    },
    "mapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "git_commit": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{7,40}$"
        },
        "configuration_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "portal_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intake_id", "schema_version", "source_ref"],
      "properties": {
        "intake_id": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "submitted_at_utc": { "type": ["string", "null"], "format": "date-time" },
        "operator_id": { "type": ["string", "null"] },
        "source_ref": { "$ref": "#/$defs/artifact_ref" },
        "field_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_ref" }
        }
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "bundle_manifest_ref", "aoi_report_refs"],
      "properties": {
        "bundle_id": { "type": "string", "minLength": 1 },
        "bundle_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "bundle_manifest_ref": { "$ref": "#/$defs/artifact_ref" },
        "aoi_report_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_ref" }
        },
        "derived_output_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_ref" }
        }
      }
    },
    "field_values": {
      "type": "array",
      "minItems": 1,
      "description": "DDS draft field values and their field-level provenance. Values may be incomplete; validation_result records blocking gaps.",
      "items": { "$ref": "#/$defs/dds_field_value" }
    },
    "pre_submission_gates": {
      "type": "array",
      "description": "Internal evidence, risk, and mitigation gates. Gate status is review readiness only and is not a compliance conclusion.",
      "items": { "$ref": "#/$defs/gate_result" }
    },
    "validation_result": {
      "$ref": "#/$defs/validation_result"
    },
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "artifacts"],
      "properties": {
        "hash_algorithm": {
          "type": "string",
          "enum": ["sha256"]
        },
        "bundle_manifest_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "dds_draft_payload_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of a serialized DDS payload candidate, when candidate serialization is possible."
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_ref" }
        }
      }
    },
    "payload_candidate": {
      "type": ["object", "null"],
      "description": "Optional structured payload candidate for a DDS client. Presence means only that serialization was possible.",
      "additionalProperties": true
    },
    "review_state": {
      "type": "string",
      "enum": [
        "draft",
        "evidence_processing",
        "analyst_review",
        "mitigation_required",
        "ready_for_operator_review"
      ],
      "description": "Pre-submission workflow state. Submission and approval records are outside this draft evidence contract."
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_eudr_compliance_determination",
        "no_unattended_submission",
        "requires_operator_review"
      ],
      "properties": {
        "not_eudr_compliance_determination": {
          "type": "boolean",
          "const": true
        },
        "no_unattended_submission": {
          "type": "boolean",
          "const": true
        },
        "requires_operator_review": {
          "type": "boolean",
          "const": true
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relpath", "sha256"],
      "properties": {
        "relpath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "content_type": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "source_system": { "type": ["string", "null"] }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_id"],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "portal_intake",
            "evidence_bundle",
            "aoi_report",
            "manual_entry",
            "derived_value",
            "system_generated"
          ]
        },
        "source_id": { "type": "string", "minLength": 1 },
        "json_pointer": { "type": ["string", "null"] },
        "relpath": { "type": ["string", "null"] },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "field_id": { "type": ["string", "null"] }
      }
    },
    "json_value": {
      "type": [
        "array",
        "boolean",
        "integer",
        "null",
        "number",
        "object",
        "string"
      ]
    },
    "dds_field_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "value",
        "value_type",
        "source_kind",
        "source_refs",
        "required_for_payload"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable mapper field identifier. It may be a DDS client model path, portal field key, or agreed mapping key."
        },
        "display_name": { "type": ["string", "null"] },
        "dds_payload_path": { "type": ["string", "null"] },
        "value": { "$ref": "#/$defs/json_value" },
        "value_type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null",
            "date",
            "date-time",
            "geojson",
            "code"
          ]
        },
        "unit": { "type": ["string", "null"] },
        "source_kind": {
          "type": "string",
          "enum": [
            "portal_intake",
            "evidence_bundle",
            "manual_entry",
            "derived_value",
            "system_generated"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_ref" }
        },
        "manual_entry": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["entered_at_utc"],
          "properties": {
            "entered_by": { "type": ["string", "null"] },
            "entered_at_utc": { "type": "string", "format": "date-time" },
            "review_note": { "type": ["string", "null"] }
          }
        },
        "derived_value": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["method_id", "method_version", "input_refs"],
          "properties": {
            "method_id": { "type": "string", "minLength": 1 },
            "method_version": { "type": "string", "minLength": 1 },
            "code_ref": { "$ref": "#/$defs/artifact_ref" },
            "input_refs": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/source_ref" }
            }
          }
        },
        "required_for_payload": { "type": "boolean" },
        "mapping_status": {
          "type": "string",
          "enum": [
            "mapped",
            "missing",
            "ambiguous",
            "partial",
            "not_applicable"
          ],
          "default": "mapped"
        }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "blocking"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "warning", "blocked", "not_evaluated"]
        },
        "blocking": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_ref" }
        }
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "schema_version",
        "mapper_version",
        "errors",
        "warnings",
        "missing_mandatory_fields",
        "ambiguous_mappings",
        "blocked_gates"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "valid_for_operator_review",
            "warnings_present",
            "blocked_by_validation"
          ],
          "description": "Validation status for draft completeness and review readiness only."
        },
        "schema_version": { "type": "string", "const": "dds_draft_v1" },
        "mapper_version": { "type": "string", "minLength": 1 },
        "validated_at_utc": { "type": ["string", "null"], "format": "date-time" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_failure" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_failure" }
        },
        "missing_mandatory_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "ambiguous_mappings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_gates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "payload_candidate_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "validation_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "category",
        "message",
        "blocking"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$",
          "description": "Stable machine-readable failure code."
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        },
        "category": {
          "type": "string",
          "enum": [
            "missing_field",
            "invalid_value",
            "ambiguous_mapping",
            "partial_mapping",
            "evidence_missing",
            "hash_mismatch",
            "gate_blocked",
            "serialization_blocked",
            "operator_review_required"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "field_id": { "type": ["string", "null"] },
        "json_pointer": { "type": ["string", "null"] },
        "requirement_ref": { "type": ["string", "null"] },
        "remediation_code": {
          "type": ["string", "null"],
          "pattern": "^[A-Z0-9_]+$"
        },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_ref" }
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
